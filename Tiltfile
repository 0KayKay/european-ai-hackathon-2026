k8s_yaml(kustomize('infrastructure'))

docker_build('local/backend', 'backend')
docker_build('local/frontend', 'frontend')
docker_build('local/auth', 'frontend', dockerfile='frontend/Dockerfile.auth')
docker_build('local/deepteam', 'deepteam')
docker_build('local/guardrail', 'guardrail')

k8s_resource('frontend', port_forwards=['5000:80', '6006:6006'])
k8s_resource('backend', port_forwards='5001:8000')
k8s_resource('deepteam', port_forwards='5002:8080', resource_deps=['backend', 'agentgateway'])
k8s_resource('auth', port_forwards='3005:3000', resource_deps=['postgres'])
k8s_resource('guardrail', port_forwards='5003:8000')
k8s_resource('agentgateway', port_forwards='4000:3000', resource_deps=['guardrail'])
k8s_resource('phoenix', resource_deps=['postgres'])
