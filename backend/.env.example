AGENTGATEWAY_URL=http://localhost:4000/v1
AGENTGATEWAY_API_KEY=REPLACE_WITH_GATEWAY_INTERNAL_KEY
AUTH_SERVICE_URL=http://localhost:3005
GOOGLE_STORAGE_BUCKET=
PRETTY_DOMAIN=localhost:5000
FILE_STORAGE=local
PHOENIX_OTLP_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_API_KEY=
GUARDRAIL_TIMEOUT_SECONDS=30
CHALLENGE_TIMEOUT_SECONDS=300
DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=devpassword
DB_NAME=app

# Arena runs: `postgres` (default) or `memory` (no database; runs are lost on restart).
ARENA_STORE=postgres
# The deepteam service (Tilt forwards it to localhost:5002).
DEEPTEAM_URL=http://localhost:5002
# Base URL under which the deepteam service reaches this backend for multi-turn attacks
# (<ARENA_CALLBACK_URL>/api/v1/arena/internal/...). From a Kind or Docker Desktop pod the host is usually
# http://host.docker.internal:8000; inside the cluster it is http://backend:8000.
ARENA_CALLBACK_URL=http://host.docker.internal:8000
