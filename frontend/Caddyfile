:80 {
    handle /api/auth/* {
        reverse_proxy auth:3000
    }

    handle /api/deepteam/* {
        reverse_proxy deepteam:8080
    }

    handle /api/* {
        reverse_proxy agentgateway:3000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

:6006 {
    forward_auth auth:3000 {
        uri /api/auth/authorize
    }
    reverse_proxy phoenix:6006
}
