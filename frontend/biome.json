{
	"files": {
		"includes": [
			"**",
			"!**/*.gen.ts",
			"!coverage",
			"!node_modules",
			"!.vite",
			"!.vscode",
			"!.idea",
			"!.pnpm",
			"!.claude",
			"!dist"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noNonNullAssertion": "off"
			},
			"a11y": {
				"noSvgWithoutTitle": "off"
			},
			"suspicious": {
				"noShorthandPropertyOverrides": "off",
				"noExplicitAny": "off",
				"noUnknownAtRules": "off",
				"noDocumentCookie": "off"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
