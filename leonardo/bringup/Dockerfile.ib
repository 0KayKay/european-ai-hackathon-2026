# Only needed if 00_prepare / 03_nccl_check show NCCL falling back to
# NET/Socket because the image lacks InfiniBand userspace libraries.
# Build it where you have Docker (laptop, CI), push to your registry, then on
# Leonardo:  VLLM_IMAGE=docker://<registry>/vllm-ib:<tag> VLLM_TAG=<tag>-ib sbatch 00_prepare.sbatch
ARG VLLM_TAG=latest
FROM vllm/vllm-openai:${VLLM_TAG}
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libibverbs1 ibverbs-providers rdma-core ibverbs-utils infiniband-diags \
 && rm -rf /var/lib/apt/lists/*
